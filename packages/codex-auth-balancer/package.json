{
  "name": "@bravo/codex-auth-balancer",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "Owned-state Codex auth balancer library and CLI.",
  "keywords": ["pi-package"],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./extensions/pi": {
      "types": "./dist/extensions/pi/index.d.ts",
      "import": "./dist/extensions/pi/index.js"
    }
  },
  "bin": {
    "codex-auth-balancer": "./dist/src/cli.js",
    "pi-balanced": "./dist/src/pi-balanced.js"
  },
  "scripts": {
    "check": "node scripts/check-pi-ai-drift.mjs && tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && chmod +x dist/src/cli.js dist/src/pi-balanced.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "latest"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  },
  "engines": { "node": ">=22.13" }
}
