{
  "name": "@bravo/render-clock",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Single shared, change-aware render clock for Pi extensions: one timer, per-subscriber intervals, deterministic test injection.",
  "keywords": [
    "pi-package"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
